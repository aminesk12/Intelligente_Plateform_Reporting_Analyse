# Copy to `.env` and fill in. Loaded automatically by the config loader.
# NEVER commit the real .env — it holds secrets.

# --- Logging ---
ETL_LOG_LEVEL=INFO

# --- Database ---


# --- Oracle (load destination: the "ETLS" database) ---
ORACLE_HOST='Host name'
ORACLE_PORT='Port number'
# Service name, not SID — required for a multitenant PDB (see
# ETLS/config/database_config.yaml). Also don't point this at SYSTEM/SYS;
# use a dedicated app user so SQLAlchemy's Oracle reflection works.
ORACLE_SERVICE_NAME=FREEPDB1
ORACLE_USER=etl_user
ORACLE_PASSWORD=change-me

# --- PostgreSQL (load destination: the "PFE_DATABASE" database) ---
POSTGRES_HOST='Host name'
POSTGRES_PORT='Port number'
POSTGRES_DB='DataBase name '
POSTGRES_USER='user name'
POSTGRES_PASSWORD=change-me

# --- REST API ---
API_TOKEN=
# API_KEY=
# API_USER=
# API_PASSWORD=

# --- SAP OData ---
SAP_BASE_URL=https://sap-host:443/sap/opu/odata/sap/ZSALES_SRV
SAP_CLIENT=100
SAP_USER=
SAP_PASSWORD=
